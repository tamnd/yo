# Not `/target`. The fuzz directory is excluded from the workspace and so has a
# build directory of its own, and the anchored form did not cover it, which is
# how two hundred megabytes of object files ended up committed.
target/
**/*.rs.bk
*.profraw
/bench/results
/.idea
/.vscode
.DS_Store

# Python leaves these beside xtask/reserve.py and they are not source.
__pycache__/
